NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-publishable-key
# Kizárólag szerveroldali admin Auth műveletekhez. NEXT_PUBLIC_ előtag tilos.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
SITE_URL=http://localhost:3000

# Foglalási e-mail worker. Alapértelmezésben nem claimel és nem küld levelet.
BOOKING_EMAIL_MODE=disabled
BOOKING_EMAIL_BATCH_SIZE=10
BOOKING_EMAIL_LEASE_SECONDS=300
BOOKING_EMAIL_FROM=A-Hely Foglalás <foglalas@a-hely.com>
BOOKING_EMAIL_REPLY_TO=foglalas@a-hely.com
BOOKING_EMAIL_MESSAGE_ID_DOMAIN=a-hely.com

# Kizárólag a belső worker Route Handler Authorization Bearer titka.
CRON_SECRET=replace-with-a-long-random-secret

# Csak BOOKING_EMAIL_MODE=send esetén szükséges. SMTP_PASS értéket tilos commitolni.
SMTP_HOST=pop3.mediacenter.hu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=foglalas@a-hely.com
SMTP_PASS=
